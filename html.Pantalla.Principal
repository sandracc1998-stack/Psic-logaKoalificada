</head>
<body>

<!-- MENÚ DE NAVEGACIÓN (TEMPORALMENTE DESACTIVADO) -->
<nav class="nav-principal">
  <a href="#" class="nav-logo">
    Sandra Carrera Castaño - <span class="colegiada">NºColegiada: G-07583</span>
  </a>
  <ul class="nav-links">
    <!-- Se cambian los destinos a # para que no abran las páginas a medio hacer -->
    <li><a href="#">Mis Valores</a></li>
